{
  "manifest_version": 3,
  "name": "Host Groups",
  "version": "1.0.0",
  "description": "Raggruppa automaticamente le schede con regole per host, nome e colore. Ideale per staging e produzione.",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "tabGroups", "storage", "alarms"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Host Groups",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "incognito": "not_allowed",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none';" }
}
